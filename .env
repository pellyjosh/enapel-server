APP_NAME="Enapel Server"
APP_ENV=production
APP_KEY=base64:aEGSWzbMRd3rFE4jc1CCqFH1ZqIe+3/hMAkGdDGcng4=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

# NativePHP desktop + LAN server settings
# Set `NATIVEPHP_ALLOW_LAN=false` if you want the desktop app to stay local-only.
NATIVEPHP_ALLOW_LAN=true
# `0.0.0.0` exposes the embedded server to other devices on the same LAN.
NATIVEPHP_SERVER_HOST=0.0.0.0
# Keep this fixed so terminals and browsers can use a predictable address.
NATIVEPHP_SERVER_PORT=8000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── enapel-cloud License Bridge ─────────────────────────────────────────────
# The license key issued by enapel-cloud after a successful subscription
LICENSE_KEY=

# The hosted enapel-cloud URL
ENAPEL_CLOUD_URL=https://enapel.hubolux.com

# A unique UUID for THIS terminal (generate once with: uuidgen)
TERMINAL_IDENTIFIER=

# Human readable label for this terminal
TERMINAL_NAME="Main Terminal"

# Offline grace period in hours before re-checking cloud
LICENSE_GRACE_HOURS=24
